# Copy to .env. Static capabilities are in config/<platform>.json

# android | ios
PLATFORM=android

# Where the session runs: local (Appium on this machine) | browserstack
DRIVER_PROVIDER=local

# BrowserStack App Automate, used when DRIVER_PROVIDER=browserstack (or by npm run bs:upload)
# BROWSERSTACK_USERNAME=
# BROWSERSTACK_ACCESS_KEY=
# app: "bs://..." from the upload, or a custom id (npm run bs:upload sends it as custom_id)
# BROWSERSTACK_APP=SwagLabs
# BROWSERSTACK_DEVICE=Google Pixel 8
# BROWSERSTACK_OS_VERSION=14.0
# BROWSERSTACK_BUILD=

# Appium is started automatically by the tests when nothing answers here (local host only)
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Android SDK for Appium. Needed when the tests start Appium from an IDE,
# which does not read ~/.bashrc and so has no ANDROID_HOME
# ANDROID_HOME=/home/<user>/Android/Sdk

DEVICE_NAME=emulator-5554
# PLATFORM_VERSION=14
# UDID=emulator-5554

# .apk for Android, .app/.ipa for iOS
APP_PATH=./apps/app.apk

# trace | debug | info | warn | error | silent
WDIO_LOG_LEVEL=warn
