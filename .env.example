# Copy to .env. Static capabilities are in config/<platform>.json

# android | ios
PLATFORM=android

# Appium is started automatically by the tests when nothing answers here (local host only)
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Android SDK for Appium. Needed when the tests start Appium from an IDE,
# which does not read ~/.bashrc and so has no ANDROID_HOME
# ANDROID_HOME=/home/<user>/Android/Sdk

DEVICE_NAME=emulator-5554
# PLATFORM_VERSION=14
# UDID=emulator-5554

# .apk for Android, .app/.ipa for iOS
APP_PATH=./apps/app.apk

# trace | debug | info | warn | error | silent
WDIO_LOG_LEVEL=warn
