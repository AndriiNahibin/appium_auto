{
  "name": "appium-auto",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile UI autotests for Android and iOS: TypeScript + WebdriverIO + Appium",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "mocha 'test/**/*.ts'",
    "test:browserstack": "DRIVER_PROVIDER=browserstack mocha 'test/**/*.ts'",
    "test:browserstack:fresh": "npm run bs:upload && npm run test:browserstack",
    "test:browserstack:all": "tsx scripts/browserstackRunAll.ts",
    "bs:upload": "tsx scripts/browserstackUpload.ts",
    "report": "allure generate allure-results && allure open allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "allure": "~3.20.1",
    "allure-js-commons": "^3.13.0",
    "allure-mocha": "^3.13.0",
    "appium": "~3.8.0",
    "appium-uiautomator2-driver": "~8.7.0",
    "chai": "^5.3.3",
    "dotenv": "^17.4.2",
    "eslint": "~10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "fast-sort": "^3.4.1",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "webdriverio": "^9.32.0",
    "zod": "^4.6.7"
  }
}
